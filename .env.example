# --- Provedor LLM ---
# Valores possíveis: anthropic (padrão) | groq | ollama
LLM_PROVIDER=anthropic

# Anthropic (produção)
ANTHROPIC_API_KEY=sk-ant-...

# Groq (alternativa gratuita — console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, sem key)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Entrega por e-mail via SMTP (opcional) ---
# Se não configurado, o digest é salvo apenas em outputs/
DIGEST_SMTP_HOST=smtp.gmail.com
DIGEST_SMTP_PORT=587
DIGEST_SMTP_USER=seu@email.com
DIGEST_SMTP_PASS=sua_senha_de_app
DIGEST_RECIPIENT_EMAIL=destinatario@email.com
